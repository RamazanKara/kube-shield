# kube-shield configuration
# Place this file as .kube-shield.yaml in your project root or ~/.kube-shield.yaml

# Kubernetes context to use (empty = current context)
context: ""

# Namespace to scan (empty = all namespaces)
namespace: ""

# Output format: table, json, sarif
output: table

# Scanners to enable (empty = all)
scanners:
  - workload
  - rbac
  - netpol
  - secrets
  - cis

# Severity threshold: only report findings at or above this level
# Options: info, low, medium, high, critical
severity: low

# Scan timeout
timeout: 5m

# Exit code behavior
# If true, exit with non-zero code when findings match severity threshold
exit-code: false

# Filter findings by category (empty = all)
# Options: workload, cis, rbac, netpol, secrets
categories: []

# AI-powered analysis
ai:
  # Provider: openai, ollama, or empty to disable
  provider: ""
  # Model name (e.g., gpt-4, llama3)
  model: ""
  # API key (prefer KUBE_SHIELD_AI_APIKEY env var for OpenAI)
  apikey: ""
  # Endpoint URL (defaults: OpenAI=https://api.openai.com/v1, Ollama=http://localhost:11434)
  endpoint: ""
